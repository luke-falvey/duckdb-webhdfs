<?xml version="1.0"?>
<configuration>
  <property><name>dfs.replication</name><value>1</value></property>
  <property><name>dfs.namenode.name.dir</name><value>/tmp/hadoop/nn</value></property>
  <property><name>dfs.datanode.data.dir</name><value>/tmp/hadoop/dn</value></property>
  <property><name>dfs.namenode.http-address</name><value>0.0.0.0:9870</value></property>
  <property><name>dfs.datanode.http.address</name><value>0.0.0.0:9864</value></property>
  <!-- the DataNode registers as localhost, so redirects point at the published port -->
  <property><name>dfs.datanode.hostname</name><value>localhost</value></property>
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <property><name>dfs.permissions.enabled</name><value>true</value></property>
  <property><name>dfs.namenode.acls.enabled</name><value>true</value></property>
  <property><name>dfs.webhdfs.enabled</name><value>true</value></property>
  <property><name>dfs.namenode.safemode.extension</name><value>0</value></property>
  <!-- small batches so LISTSTATUS_BATCH paging is exercised -->
  <property><name>dfs.ls.limit</name><value>5</value></property>
</configuration>
