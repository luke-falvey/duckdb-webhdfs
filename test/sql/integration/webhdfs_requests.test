# name: test/sql/integration/webhdfs_requests.test
# description: the requests reads and listings send, counted per WebHDFS operation from DuckDB's HTTP log
# group: [integration]

require webhdfs

require httpfs

require parquet

require-env WEBHDFS_TEST_RUNNING

statement ok
SET webhdfs_user_name = 'hadoop';

statement ok
SET threads = 1;

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage = 'memory');

statement ok
CREATE MACRO ops() AS TABLE
SELECT regexp_extract(request.url, 'op=([A-Z_]+)', 1) AS op, regexp_extract(request.url, '//([^/]+)/', 1) = 'localhost:9870' AS namenode, count(*) AS n
FROM duckdb_logs_parsed('HTTP') GROUP BY ALL ORDER BY ALL;

# a glob of Parquet files: the listing's size and mtime open every file, so there is no GETFILESTATUS; one OPEN
# goes to the NameNode and one to the DataNode per file
query I
SELECT count(*) FROM read_parquet('webhdfs://localhost:9870/test/hive/year=2023/month=*/*.parquet');
----
120

query TTI
FROM ops();
----
LISTSTATUS_BATCH	true	15
OPEN	false	12
OPEN	true	12

# the listing carries an etag, so the Parquet metadata cache can validate the files without opening them. The
# small-file cache is off here, or it would hide whether the files are opened again
statement ok
SET GLOBAL webhdfs_small_file_cache_size = 0;

statement ok
SET parquet_metadata_cache = true;

statement ok
CALL truncate_duckdb_logs();

# the warm-up opens every file once (count(*) reads only the footer; at the DataNode, as the redirects are reused from
# the first scan)
statement ok
SELECT count(*) FROM read_parquet('webhdfs://localhost:9870/test/hive/year=2023/month=*/*.parquet');

query TTI
FROM ops();
----
LISTSTATUS_BATCH	true	15
OPEN	false	12

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM read_parquet('webhdfs://localhost:9870/test/hive/year=2023/month=*/*.parquet');
----
120

query TTI
FROM ops();
----
LISTSTATUS_BATCH	true	15

# without the metadata cache the same scan opens the files again
statement ok
SET parquet_metadata_cache = false;

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT count(*) FROM read_parquet('webhdfs://localhost:9870/test/hive/year=2023/month=*/*.parquet');

query TTI
FROM ops();
----
LISTSTATUS_BATCH	true	15
OPEN	false	12

# a file that is replaced, with the same number of rows, gets a new tag: its cached metadata is not used. (The new
# file also has a new mtime, so this passes without the fileId in the tag too; test/cpp pins the tag itself.)
statement ok
SET parquet_metadata_cache = true;

statement ok
COPY (SELECT range FROM range(10)) TO 'webhdfs://localhost:9870/test/out/requests_etag/t.parquet';

query I
SELECT sum(range) FROM read_parquet('webhdfs://localhost:9870/test/out/requests_etag/*.parquet');
----
45

statement ok
COPY (SELECT range FROM range(10, 20)) TO 'webhdfs://localhost:9870/test/out/requests_etag/t.parquet';

statement ok
CALL truncate_duckdb_logs();

query I
SELECT sum(range) FROM read_parquet('webhdfs://localhost:9870/test/out/requests_etag/*.parquet');
----
145

# a new redirect for the new version, and (with the small-file cache off) the footer and the data read separately
query TTI
FROM ops();
----
LISTSTATUS_BATCH	true	1
OPEN	false	2
OPEN	true	1

statement ok
RESET parquet_metadata_cache;

statement ok
RESET GLOBAL webhdfs_small_file_cache_size;

statement ok
CALL truncate_duckdb_logs();

# webhdfs_ls of a plain directory: one GETFILESTATUS, then the listing pages (dfs.ls.limit = 5)
query I
SELECT count(*) FROM webhdfs_ls('webhdfs://localhost:9870/test/many');
----
200

query TTI
FROM ops();
----
GETFILESTATUS	true	1
LISTSTATUS_BATCH	true	40

statement ok
CALL truncate_duckdb_logs();

# a small file read whole is cached: reading it again costs no DataNode request
statement ok
SELECT * FROM read_parquet('webhdfs://localhost:9870/test/data/numbers.parquet') LIMIT 1;

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

# no OPEN, and one GETFILESTATUS, from resolving the path. Since DuckDB v2.0.1 the CSV reader opens the resolved file
# with its extended_info (sniff and scan), so neither open stats it again (O6)
query TTI
FROM ops();
----
GETFILESTATUS	true	1

# a new cache size applies to the clusters in use right away: setting it to 0 drops the cached file even though no
# request is made before it is raised again. The read fetches the file from the DataNode again (with the redirect
# reused from the first read, so without the NameNode)
statement ok
SET GLOBAL webhdfs_small_file_cache_size = 0;

statement ok
RESET GLOBAL webhdfs_small_file_cache_size;

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

query TTI
FROM ops() WHERE op = 'OPEN';
----
OPEN	false	1

# ... and RESET turned it back on: the file read just now is cached again
statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

query I
SELECT count(*) FROM ops() WHERE op = 'OPEN';
----
0

# SET to NULL means the default, as RESET does: the cache is on again
statement ok
SET GLOBAL webhdfs_small_file_cache_size = 0;

statement ok
SET GLOBAL webhdfs_small_file_cache_size = NULL;

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

query I
SELECT count(*) FROM ops() WHERE op = 'OPEN';
----
0

statement ok
RESET GLOBAL webhdfs_small_file_cache_size;

# with the cache off, reading the file again fetches it again
statement ok
SET GLOBAL webhdfs_small_file_cache_size = 0;

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT * FROM read_csv('webhdfs://localhost:9870/test/data/people.csv');

query TTI
FROM ops() WHERE op = 'OPEN';
----
OPEN	false	1

statement ok
RESET GLOBAL webhdfs_small_file_cache_size;

# an empty xattr filter selects nothing, but still checks that the path exists: one GETFILESTATUS, no GETXATTRS
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM webhdfs_xattrs('webhdfs://localhost:9870/test/data/people.csv', names := []);
----
0

query TTI
FROM ops();
----
GETFILESTATUS	true	1
