# name: test/sql/webhdfs_no_cluster.test
# description: webhdfs behaviour that needs no cluster
# group: [sql]

require webhdfs

require httpfs

query IIIII
SELECT current_setting('webhdfs_list_parallelism'), current_setting('webhdfs_include_hidden'), current_setting('webhdfs_write_chunk_size'), current_setting('webhdfs_read_buffer_size'), current_setting('webhdfs_reuse_redirects');
----
16	false	67108864	1048576	true

# the small-file cache: 64 MiB by default, 0 disables it
query I
SELECT current_setting('webhdfs_small_file_cache_size');
----
67108864

# the cache is shared by every session: a plain SET sets it database-wide, a session value is refused
statement ok
SET webhdfs_small_file_cache_size = 0;

query I
SELECT current_setting('webhdfs_small_file_cache_size');
----
0

statement error
SET SESSION webhdfs_small_file_cache_size = 1024;
----
cannot be set as a session variable - it can only be set globally

statement ok
RESET webhdfs_small_file_cache_size;

query I
SELECT current_setting('webhdfs_small_file_cache_size');
----
67108864

# invalid URLs
statement error
SELECT * FROM read_csv('webhdfs:///data/x.csv');
----
missing NameNode host

statement error
SELECT * FROM read_csv('webhdfs://nn:99999/x.csv');
----
invalid host or port

statement error
SELECT * FROM read_csv('webhdfs://user@nn/x.csv');
----
user names in the URL are not supported

statement error
SELECT * FROM read_csv('webhdfs://localhost:1/a/{b,c/x.csv');
----
Invalid WebHDFS glob pattern

# nothing listens on port 1
statement error
SELECT * FROM read_csv('webhdfs://localhost:1/x.csv');
----
no NameNode could serve the request

statement error
SELECT * FROM read_csv('swebhdfs://localhost:1/data/*.csv');
----
no NameNode could serve the request

statement error
SELECT * FROM webhdfs_ls('webhdfs://localhost:1/');
----
no NameNode could serve the request

query TTTII
SELECT endpoint, namenode, state, active, last_error IS NOT NULL FROM webhdfs_namenodes() WHERE endpoint = 'webhdfs://localhost:1';
----
webhdfs://localhost:1	localhost:1	unreachable	false	true

query I
SELECT webhdfs_exists(NULL);
----
NULL

# secrets
statement ok
CREATE SECRET hdfs_a (TYPE webhdfs, SCOPE 'webhdfs://cluster-a', USER_NAME 'alice', DELEGATION_TOKEN 'tok123', NAMENODES ['nn1:9870', 'nn2:9870'], DATANODE_ADDRESS_MAP MAP {'dn1:9864': 'localhost:9864'}, GATEWAY_PATH '/gateway/default', USE_SSL false, REPLICATION 2, BLOCK_SIZE 1048576, PERMISSION '640');

query TTTT
SELECT name, type, provider, scope FROM duckdb_secrets() WHERE name = 'hdfs_a';
----
hdfs_a	webhdfs	config	['webhdfs://cluster-a']

# the delegation token is redacted
query I
SELECT secret_string NOT LIKE '%tok123%' FROM duckdb_secrets() WHERE name = 'hdfs_a';
----
true

statement ok
CREATE SECRET hdfs_default (TYPE webhdfs);

query T
SELECT scope FROM duckdb_secrets() WHERE name = 'hdfs_default';
----
['webhdfs://', 'swebhdfs://']

# scopes match whole authorities: 'cluster-a' is not a prefix match for 'cluster-ab' or 'cluster-a:9870'
query T
SELECT name FROM which_secret('webhdfs://cluster-a/data/x.parquet', 'webhdfs');
----
hdfs_a

query T
SELECT name FROM which_secret('WEBHDFS://Cluster-A/x', 'webhdfs');
----
hdfs_a

query T
SELECT name FROM which_secret('webhdfs://cluster-a', 'webhdfs');
----
hdfs_a

query T
SELECT name FROM which_secret('webhdfs://cluster-ab/x', 'webhdfs');
----
hdfs_default

query T
SELECT name FROM which_secret('webhdfs://cluster-a:9870/x', 'webhdfs');
----
hdfs_default

query T
SELECT name FROM which_secret('swebhdfs://cluster-a/x', 'webhdfs');
----
hdfs_default

# a scope with a path is a prefix match after the authority
statement ok
CREATE SECRET hdfs_a_logs (TYPE webhdfs, SCOPE 'webhdfs://cluster-a/logs');

query T
SELECT name FROM which_secret('webhdfs://cluster-a/logs/2024/x', 'webhdfs');
----
hdfs_a_logs

query T
SELECT name FROM which_secret('webhdfs://cluster-a/data/x', 'webhdfs');
----
hdfs_a

query T
SELECT name FROM which_secret('webhdfs://cluster-a/LOGS/x', 'webhdfs');
----
hdfs_a

statement ok
DROP SECRET hdfs_a_logs;

statement error
CREATE SECRET bad1 (TYPE webhdfs, AUTH 'basic');
----
AUTH must be 'simple', 'token', 'kerberos' or 'none'

statement error
CREATE SECRET bad2 (TYPE webhdfs, NO_SUCH_OPTION 'x');
----
Unknown parameter

# AUTH 'token' needs a token, and a token goes with AUTH 'token' (or no AUTH) only
statement error
CREATE SECRET tok (TYPE webhdfs, SCOPE 'webhdfs://localhost:2', AUTH 'token');
----
AUTH 'token' needs a DELEGATION_TOKEN

statement error
CREATE SECRET tok (TYPE webhdfs, AUTH 'TOKEN', DELEGATION_TOKEN '');
----
AUTH 'token' needs a DELEGATION_TOKEN

statement error
CREATE SECRET tok (TYPE webhdfs, AUTH 'simple', DELEGATION_TOKEN 'tok');
----
DELEGATION_TOKEN can only be used with AUTH 'token'

statement error
CREATE SECRET tok (TYPE webhdfs, AUTH 'kerberos', DELEGATION_TOKEN 'tok');
----
DELEGATION_TOKEN can only be used with AUTH 'token'

statement error
CREATE SECRET tok (TYPE webhdfs, AUTH 'none', DELEGATION_TOKEN 'tok');
----
DELEGATION_TOKEN can only be used with AUTH 'token'

statement ok
CREATE SECRET tok (TYPE webhdfs, SCOPE 'webhdfs://tok-explicit', AUTH 'token', DELEGATION_TOKEN 'tok');

statement ok
CREATE SECRET tok_implicit (TYPE webhdfs, SCOPE 'webhdfs://tok-implicit', DELEGATION_TOKEN 'tok');

statement ok
DROP SECRET tok;

statement ok
DROP SECRET tok_implicit;

# NAMENODES entries are host:port: no scheme, no path, a numeric port
statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['http://nn1:9870']);
----
NAMENODES entry 'http://nn1:9870' must be host:port

statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['nn1:9870/webhdfs']);
----
NAMENODES entry 'nn1:9870/webhdfs' must be host:port

statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['nn1']);
----
NAMENODES entry 'nn1' must be host:port

statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['nn1:http']);
----
NAMENODES entry 'nn1:http' must be host:port

statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['nn1:9870', 'nn2:']);
----
NAMENODES entry 'nn2:' must be host:port

statement error
CREATE SECRET nn_bad (TYPE webhdfs, NAMENODES ['']);
----
NAMENODES entry '' is empty

# a scope no webhdfs URL can match would leave the secret silently unused
statement error
CREATE SECRET bad_scope (TYPE webhdfs, SCOPE 'hdfs://prod');
----
SCOPE 'hdfs://prod' must start with 'webhdfs://' or 'swebhdfs://'

statement error
CREATE SECRET bad_scope (TYPE webhdfs, SCOPE ['webhdfs://ok', 'prod']);
----
SCOPE 'prod' must start with 'webhdfs://' or 'swebhdfs://' (e.g. 'webhdfs://namenode:9870' for one cluster, 'webhdfs://' for all)

# the whole scheme is required: 'webhdfs:/' would match every webhdfs:// URL, 'WEBHDFS' and 'w' none
statement error
CREATE SECRET bad_scope (TYPE webhdfs, SCOPE 'webhdfs:/');
----
SCOPE 'webhdfs:/' must start with 'webhdfs://' or 'swebhdfs://'

statement error
CREATE SECRET bad_scope (TYPE webhdfs, SCOPE 'WEBHDFS');
----
SCOPE 'WEBHDFS' must start with 'webhdfs://' or 'swebhdfs://'

statement error
CREATE SECRET bad_scope (TYPE webhdfs, SCOPE 'w');
----
SCOPE 'w' must start with 'webhdfs://' or 'swebhdfs://'

statement ok
CREATE SECRET scheme_scope (TYPE webhdfs, SCOPE 'SWEBHDFS://prod');

# every cluster of a scheme is asked for explicitly
statement ok
CREATE SECRET all_scope (TYPE webhdfs, SCOPE 'webhdfs://');

statement ok
DROP SECRET all_scope;

statement ok
DROP SECRET scheme_scope;

# REPLICATION and BLOCK_SIZE must be positive (and the replication factor fit HDFS's short)
statement error
CREATE SECRET bad_repl (TYPE webhdfs, REPLICATION 0);
----
REPLICATION must be between 1 and 32767, not 0

statement error
CREATE SECRET bad_repl (TYPE webhdfs, REPLICATION 40000);
----
REPLICATION must be between 1 and 32767, not 40000

statement error
CREATE SECRET bad_block (TYPE webhdfs, BLOCK_SIZE -1);
----
BLOCK_SIZE must be between 1 and 9223372036854775807, not -1

statement ok
CREATE SECRET nn_ok (TYPE webhdfs, SCOPE 'webhdfs://nn-ok', NAMENODES ['nn1:9870,nn2:9870', '[::1]:9870']);

statement ok
DROP SECRET nn_ok;

# HA: every NameNode of the list is tried
statement ok
CREATE SECRET dead (TYPE webhdfs, SCOPE 'webhdfs://deadlist', NAMENODES ['localhost:1', 'localhost:2']);

statement error
SELECT * FROM read_csv('webhdfs://deadlist/x.csv');
----
localhost:2: 

query IITT
SELECT count(*), bool_and(state = 'unreachable'), any_value(namenode_source), any_value(secret_name) FROM webhdfs_namenodes() WHERE endpoint = 'webhdfs://deadlist';
----
2	true	secret	dead

# a cluster name with no port, secret or hdfs-site.xml nameservice is tried as host:9870; the error says how to
# configure it (.invalid never resolves)
statement error
SELECT * FROM read_csv('webhdfs://no-such-cluster.invalid/x.csv');
----
<REGEX>:.*no NameNode could serve the request.*if "no-such-cluster.invalid" is an HA nameservice.*
