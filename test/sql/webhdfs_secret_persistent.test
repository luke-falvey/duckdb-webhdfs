# name: test/sql/webhdfs_secret_persistent.test
# description: persistent webhdfs secrets keep whole-authority scope matching after a restart
# group: [sql]

require webhdfs

load __TEST_DIR__/webhdfs_secret_persistent.db

statement ok
SET secret_directory='__TEST_DIR__/webhdfs_persistent_secrets'

statement ok
CREATE OR REPLACE PERSISTENT SECRET prod_alias (TYPE webhdfs, SCOPE 'webhdfs://prod', NAMENODES ['nn1:9870'], USER_NAME 'etl');

restart

statement ok
SET secret_directory='__TEST_DIR__/webhdfs_persistent_secrets'

query TT
SELECT name, persistent FROM which_secret('webhdfs://prod/data/x.parquet', 'webhdfs');
----
prod_alias	PERSISTENT

query I
SELECT count(*) FROM which_secret('webhdfs://prod2/data/x.parquet', 'webhdfs');
----
0

statement ok
DROP PERSISTENT SECRET prod_alias;
