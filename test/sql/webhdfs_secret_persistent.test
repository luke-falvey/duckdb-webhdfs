# name: test/sql/webhdfs_secret_persistent.test
# description: persistent webhdfs secrets keep whole-authority scope matching after a restart
# group: [sql]

require webhdfs

require httpfs

load {TEST_DIR}/webhdfs_secret_persistent.db

statement ok
SET secret_directory='{TEST_DIR}/webhdfs_persistent_secrets'

statement ok
CREATE OR REPLACE PERSISTENT SECRET prod_alias (TYPE webhdfs, SCOPE 'webhdfs://prod', NAMENODES ['nn1:9870'], USER_NAME 'etl', DELEGATION_TOKEN 'tok123');

statement ok
CREATE OR REPLACE PERSISTENT SECRET loopback (TYPE webhdfs, SCOPE 'webhdfs://127.0.0.1', NAMENODES ['localhost:1']);

restart

statement ok
SET secret_directory='{TEST_DIR}/webhdfs_persistent_secrets'

# reloaded as plain key-value secrets: everything is still there, and the token still redacted
query TTTT
SELECT name, type, persistent, scope FROM duckdb_secrets() WHERE type = 'webhdfs' ORDER BY name;
----
loopback	webhdfs	true	['webhdfs://127.0.0.1']
prod_alias	webhdfs	true	['webhdfs://prod']

query I
SELECT secret_string NOT LIKE '%tok123%' FROM duckdb_secrets() WHERE name = 'prod_alias';
----
true

query TT
SELECT name, persistent FROM which_secret('webhdfs://prod/data/x.parquet', 'webhdfs');
----
prod_alias	PERSISTENT

# the extension picks the secret itself with whole-authority matching (core's which_secret() matches a reloaded
# secret by string prefix): 'webhdfs://127.0.0.1' applies to 127.0.0.1 but not to 127.0.0.1:2
statement error
SELECT * FROM read_csv('webhdfs://127.0.0.1/x.csv');
----
no NameNode could serve the request

statement error
SELECT * FROM read_csv('webhdfs://127.0.0.1:2/x.csv');
----
no NameNode could serve the request

query TTT
SELECT namenode, namenode_source, secret_name FROM webhdfs_namenodes() WHERE namenode IN ('localhost:1', '127.0.0.1:2') ORDER BY namenode;
----
127.0.0.1:2	url	NULL
localhost:1	secret	loopback

# a temporary secret with the same scope is scored the same way and wins the tie, as in core
statement ok
CREATE SECRET loopback_tmp (TYPE webhdfs, SCOPE 'webhdfs://127.0.0.1', NAMENODES ['localhost:3']);

statement error
SELECT * FROM read_csv('webhdfs://127.0.0.1/y.csv');
----
no NameNode could serve the request

query TT
SELECT namenode, secret_name FROM webhdfs_namenodes() WHERE namenode = 'localhost:3';
----
localhost:3	loopback_tmp

# the secret columns are resolved for the caller when queried, so they follow the secrets that exist now, and only
# describe the NameNodes the resolved configuration names: localhost:3 came from the dropped secret
statement ok
DROP SECRET loopback_tmp;

query TTTT
SELECT namenode, auth_mode, namenode_source, secret_name FROM webhdfs_namenodes() WHERE endpoint = 'webhdfs://127.0.0.1' ORDER BY namenode;
----
localhost:1	simple	secret	loopback
localhost:3	NULL	NULL	NULL

statement ok
DROP PERSISTENT SECRET prod_alias;

statement ok
DROP PERSISTENT SECRET loopback;
